rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Die Website darf oeffentlich gelesen werden.
    match /data/{docId} {
      allow read: if true;

      // Gratis-Basisschutz: keine anonymen Fremdschreibungen.
      // Wichtig: Fuer echte Admin-Sicherheit langfristig Custom Claims nutzen
      // oder Schreibaktionen ueber den Cloudflare Worker fuehren.
      allow write: if signedIn();
    }

    // Firebase-Mail-Extension: nur eingeloggte User duerfen Mails anstossen.
    match /mail/{mailId} {
      allow read: if false;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
